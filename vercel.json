{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    },
    "api/audit-blank-pdf.js": {
      "maxDuration": 20,
      "includeFiles": "{nabh-data.js,audit/scope-data.js}"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "accrediq.vercel.app"
        }
      ],
      "destination": "https://aqcredix.com/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "accrediq.vercel.app"
        }
      ],
      "destination": "https://aqcredix.com/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/digest?scope=expiry",
      "schedule": "0 4 1 * *"
    }
  ]
}

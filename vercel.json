{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "accrediq.vercel.app" }],
      "destination": "https://aqcredix.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/digest?scope=expiry",
      "schedule": "0 4 1 * *"
    }
  ]
}